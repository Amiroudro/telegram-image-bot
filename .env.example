# Copy this file to .env and fill in the values. Never share .env.
# .env is in .gitignore - it will not be committed.

# 1. Telegram token from @BotFather in Telegram (send /newbot there)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 2. Cloudflare - free account at dash.cloudflare.com
#    Account ID: right sidebar on the dashboard, or in the URL.
#    API token: My Profile > API Tokens > Create Token
#    Use a Custom token with: Account - Workers AI - Edit
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# 3. Per-user daily caps (UTC day). Defaults match the README.
DAILY_TXT_LIMIT=5
DAILY_EDIT_LIMIT=3

# 4. Optional fallback - only if you have a Pollinations key.
#    Leave blank to run on Cloudflare only (the free plan).
#    Pollinations free balance is one-time Quest Pollen, ~3 pollen reported, not recurring.
POLLINATIONS_API_KEY=

# Usage database file (created automatically)
USAGE_DB=usage.db
