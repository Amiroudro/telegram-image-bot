# Copy this file to .env and fill in the values. Never share .env.
# .env is in .gitignore - it will not be committed.

# 1. Telegram token from @BotFather in Telegram (send /newbot there)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 2. Cloudflare - free account at dash.cloudflare.com
#    Account ID: right sidebar on the dashboard, or in the URL.
#    API token: My Profile > API Tokens > Create Token
#    Use a Custom token with: Account - Workers AI - Edit
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# 3. Per-user daily caps (UTC day). Defaults match the README.
DAILY_TXT_LIMIT=5
DAILY_EDIT_LIMIT=3

# 4. Fallbacks - no keys required, leave blank to use the free defaults.
#    Pollinations: if POLLINATIONS_API_KEY is set, the fallback uses the
#    better key-based flux model (1024x1024); if blank, it uses the legacy
#    no-key endpoint (Sana, 768x768, slow). Pollinations free balance is
#    one-time Quest Pollen, ~3 pollen reported, not recurring.
POLLINATIONS_API_KEY=

# 5. AI Horde (fallback #3) - optional, keyless by default.
#    The bot uses the public anonymous key 0000000000 if this is blank.
#    A free account key from https://stablehorde.net gives your jobs
#    higher queue priority. AIHORDE_MODEL picks the Horde model
#    (default "SDXL 1.0"; anonymous requests are capped at 512x512).
AIHORDE_API_KEY=
AIHORDE_MODEL=

# Usage database file (created automatically)
USAGE_DB=usage.db
